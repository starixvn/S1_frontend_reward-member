pipeline {
    agent { node { label 'Build' } }
    tools {nodejs "nodejs"}
    environment{
        node_modules_exists = fileExists 'node_modules'
        project = 'reward'
        env = 'prd'
        ansible_path = '/var/jenkins_home/ansible/frontend/prd/'
    }
    stages {
        stage('Install dependencies') {
            when {
                anyOf {
                    changeset "package.json"
                    expression { node_modules_exists == 'false' }
                }
            }
            steps {
                sh 'npm install'
            }
        }
        stage('Build') {
            steps {
                sh 'npm run export'
            }
        }
        stage('Zip'){
            steps {
                dir("dist/apps/nova88/exported"){
                    script {
                        env.commitHash = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    }
                    sh 'zip -r ${project}-${commitHash} *'
                    //sh 'curl -x http://10.4.194.104:3128 -v -u admin:123456 --upload-file ${project}-${commitHash}.zip http://13.213.82.69:8081/repository/artifacts/Frontend/${project}/${env}/${project}-${commitHash}.zip'
                    sh 'curl -v -u admin:123456 --upload-file ${project}-${commitHash}.zip http://13.213.82.69:8081/repository/artifacts/Frontend/${project}/${env}/${project}-${commitHash}.zip'
                    sh 'echo ${project}-${commitHash}'
                }
            }
        }
        // stage('Deploy') {
        //     steps {
        //         sh 'ansible-playbook -i ${ansible_path}host.yml ${ansible_path}deploy.reward.yml --extra-vars "commitId=${commitHash} project=${project} host=${project} env=${env} filename=${project}-${commitHash}"'
        //     }
        // }
    }
}