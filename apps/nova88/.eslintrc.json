{
	"extends": [
		"plugin:@nrwl/nx/react-typescript",
		"next",
		"next/core-web-vitals",
		"../../.eslintrc.json"
	],
	"ignorePatterns": ["!**/*"],
	"overrides": [
		{
			"files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
			"rules": {
				"@next/next/no-html-link-for-pages": ["error", "apps/nova88/pages"]
			}
		},
		{
			"files": ["*.ts", "*.tsx"],
			"rules": {}
		},
		{
			"files": ["*.js", "*.jsx"],
			"rules": {}
		}
	],
	"rules": {
		"no-console": "warn",
		"@next/next/no-html-link-for-pages": "off",
		"@next/next/no-img-element": "off",
		"@typescript-eslint/no-explicit-any": "off"
	},
	"env": {
		"jest": true
	}
}
